# Root-level reference. Each service reads its own .env file.
# Copy api/.env.example      -> api/.env
# Copy web/.env.example      -> web/.env

# --- api ---
# API_PORT=4000
# MONGODB_URI=mongodb://mongo:27017/carexpress
# JWT_SECRET=change-me-in-prod
# JWT_EXPIRES_IN=7d
# CACHE_TTL_HOURS=168
# AUTODEV_API_KEY=
# CARFAX_API_KEY=
# AUTOCHECK_API_KEY=
# EPICVIN_API_KEY=

# --- web ---
# NEXT_PUBLIC_API_URL=http://localhost:4000
